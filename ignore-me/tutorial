# 1. Cria a venv (chamada 'venv')
python -m venv venv

# 2. Ativa ela (no Windows)
venv\Scripts\activate
# (no Mac/Linux)
# source venv/bin/activate

# 3. Instala o Flask (o servidor web)
pip install flask

# 4. Gera o arquivo com todas as dependências
pip freeze > requirements.txt

